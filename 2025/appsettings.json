{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Level:u3} {ThreadId} {SourceContext:l} {Message:lj}{NewLine}{Exception} "
        }
      }
    ],
    "Properties": {
      "Application": "LandView"
    }
  }
}
